# ── Envio (required for HyperSync on Base, even when self-hosting) ──
# Create at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# ── Base chain ──
# Free Alchemy tier: create a Base app at https://dashboard.alchemy.com
ALCHEMY_API_KEY=
# Optional full URL override (takes precedence over ALCHEMY_API_KEY).
# Used by handler contractEffects and, on indexer container start, prepended as the
# first HyperSync fallback RPC (see scripts/ensure-base-rpc-fallbacks.mjs).
# BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/your-key

# Optional extra fallback RPC URLs (comma-separated), appended after Alchemy/public fallbacks.
# BASE_RPC_FALLBACK_URLS=https://base.llamarpc.com,https://1rpc.io/base

# ── Postgres password (random string YOU create — not Envio login, not Flux wallet) ──
ENVIO_PG_PORT=5433
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=change-me-local
ENVIO_PG_DATABASE=envio-dev
HASURA_GRAPHQL_ADMIN_SECRET=change-me-local
LOG_LEVEL=info
TUI_OFF=true

# Core indexer (local docker/core-base)
# Use 8082 locally if 8080 is taken (e.g. gotchi-world zone-router)
CORE_HASURA_PORT=8082
CORE_INDEXER_PORT=9898

# Gotchiverse indexer (local docker/gotchiverse-base)
GV_HASURA_PORT=8081
GV_INDEXER_PORT=9899
GV_PG_PORT=5435
GV_PG_DATABASE=envio-gv
# GV_HASURA_DATABASE_URL is set automatically by npm run docker:gv when ENVIO_PG_PASSWORD has / @ # etc.

# SVG indexer (local docker/svg-base)
SVG_HASURA_PORT=8084
SVG_INDEXER_PORT=9897
SVG_PG_PORT=5437
SVG_PG_DATABASE=envio-svg

# Portal SVG indexer (local docker/portal-base)
PORTAL_HASURA_PORT=8085
PORTAL_INDEXER_PORT=9896
PORTAL_PG_PORT=5438
PORTAL_PG_DATABASE=envio-portal

# Alchemica ERC-20 indexer (local docker/alchemica-base)
ALCHEMICA_HASURA_PORT=8086
ALCHEMICA_INDEXER_PORT=9895
ALCHEMICA_PG_PORT=5439
ALCHEMICA_PG_DATABASE=envio-alchemica

# GLTR staking indexer (local docker/gltr-staking-base)
STAKING_HASURA_PORT=8087
STAKING_INDEXER_PORT=9894
STAKING_PG_PORT=5440
STAKING_PG_DATABASE=envio-staking

# GBM Baazaar indexer (local docker/gbm-baazaar-base)
GBM_HASURA_PORT=8088
GBM_INDEXER_PORT=9893
GBM_PG_PORT=5441
GBM_PG_DATABASE=envio-gbm

# Base monolith (local docker/monolith-base — replaces split core+gv+proxy)
# Default 5436 avoids clash with gotchiverse-base (often on 5434) and core-base (5433).
MONOLITH_PG_PORT=5436
MONOLITH_PG_DATABASE=envio-monolith
MONOLITH_HASURA_PORT=8083
MONOLITH_INDEXER_PORT=9900
# If ENVIO_PG_PASSWORD contains / @ #, use `npm run docker:monolith` (auto URL-encodes for Hasura).
# Or set explicitly: MONOLITH_HASURA_DATABASE_URL=postgres://postgres:pass%2Fword@envio-postgres:5432/envio-monolith
# Single Hasura for all seven /subgraphs/name/* paths (set in monolith docker-compose proxy)
HASURA_URL=http://127.0.0.1:8083/v1/graphql

# ── GraphQL compatibility proxy ──
PROXY_PORT=8787
# For npm run dev:proxy on the host. Docker proxy uses host.docker.internal + *_HASURA_PORT above.
CORE_HASURA_URL=http://127.0.0.1:8082/v1/graphql
GV_HASURA_URL=http://127.0.0.1:8081/v1/graphql
SVG_HASURA_URL=http://127.0.0.1:8084/v1/graphql
PORTAL_HASURA_URL=http://127.0.0.1:8085/v1/graphql
ALCHEMICA_HASURA_URL=http://127.0.0.1:8086/v1/graphql
STAKING_HASURA_URL=http://127.0.0.1:8087/v1/graphql
GBM_HASURA_URL=http://127.0.0.1:8088/v1/graphql
HASURA_ADMIN_SECRET=change-me-local

# ── Goldsky (parity testing only) ──
GOLDSKY_CORE_URL=https://api.goldsky.com/api/public/project_cmh3flagm0001r4p25foufjtt/subgraphs/aavegotchi-core-base/prod/gn
GOLDSKY_GOTCHIVERSE_URL=https://api.goldsky.com/api/public/project_cmh3flagm0001r4p25foufjtt/subgraphs/gotchiverse-base/prod/gn
GOLDSKY_SVG_URL=https://api.goldsky.com/api/public/project_cmh3flagm0001r4p25foufjtt/subgraphs/aavegotchi-svg-base/prod/gn
# Portal Base may not be on Goldsky yet — set when available for parity
# GOLDSKY_PORTAL_URL=
GOLDSKY_API_KEY=

# ── Production VPS (docker/production) — recommended over Flux ──
# PROXY_BIND=127.0.0.1   # default: localhost only (use with Cloudflare Tunnel)
# PROXY_BIND=0.0.0.0     # only if exposing :8787 directly (not recommended)
# HASURA_GRAPHQL_ENABLE_CONSOLE=false

# ── RunOnFlux (optional; pay FLUX via Zelcore — no wallet password in .env) ──
# FLUX_ZELID=
# FLUX_INSTANCES=1
# DOCKERHUB_USER=userdefault13
# flux:prepare reads ENVIO_PG_PASSWORD for Flux postgres/hasura/indexer
# FLUX_CORE_APP_NAME=aavegotchicorev3   # new app name when old Postgres volume is stuck (was aavegotchicorev2)
# FLUX_GV_APP_NAME=gotchiversebase
# FLUX_SVG_APP_NAME=aavegotchisvgbase
# FLUX_PORTAL_APP_NAME=aavegotchiportalbase
# FLUX_ALCHEMICA_APP_NAME=aavegotchialchemicabase
# FLUX_STAKING_APP_NAME=aavegotchigltrstakingbase
# FLUX_GBM_APP_NAME=aavegotchigbmbase
# FLUX_MONOLITH_APP_NAME=aavegotchimonolithbase   # preferred: postgres+hasura+indexer+proxy
# Test before Flux: npm run flux:preflight && npm run flux:test:core

# ── Cloudflare Tunnel (production) ──
CLOUDFLARE_TUNNEL_TOKEN=
CORE_SUBGRAPH_PUBLIC_URL=https://core-subgraph.yourdomain.com
GOTCHIVERSE_SUBGRAPH_PUBLIC_URL=https://gotchiverse-subgraph.yourdomain.com
# After monolith cutover (one host :8787):
# CORE_SUBGRAPH_URL=https://<host>/subgraphs/name/aavegotchi-core-base
# GOTCHIVERSE_SUBGRAPH_URL=https://<host>/subgraphs/name/gotchiverse-base
# GBM_SUBGRAPH_URL=https://<host>/subgraphs/name/aavegotchi-gbm-baazaar-base
# SVG_SUBGRAPH_URL=https://<host>/subgraphs/name/aavegotchi-svg-base
# ALCHEMICA_SUBGRAPH_URL=https://<host>/subgraphs/name/aavegotchi-alchemica-base
# SOCKET_BRIDGE_SUBGRAPH_URL=https://<host>/subgraphs/name/socket-bridge-base
# GLTR_STAKING_SUBGRAPH_URL=https://<host>/subgraphs/name/aavegotchi-gltr-staking-base
