{
  "version": 8,
  "name": "aavegotchisubgraphproxy",
  "description": "The Graph compatibility proxy for all seven Aavegotchi Hasura backends (core, gv, svg, portal, alchemica, staking, gbm)",
  "owner": "REPLACE_WITH_FLUX_ZELID",
  "instances": 1,
  "staticip": false,
  "enterprise": "",
  "contacts": [],
  "geolocation": [],
  "compose": [
    {
      "name": "proxy",
      "description": "GraphQL compat proxy",
      "repotag": "userdefault13/aavegotchi-graphql-proxy:latest",
      "ports": [8787],
      "containerPorts": [8787],
      "domains": [""],
      "environmentParameters": [
        "PROXY_PORT=8787",
        "CORE_HASURA_URL=https://aavegotchicorev2_8080.app.runonflux.io/v1/graphql",
        "GV_HASURA_URL=https://gotchiversebase_8080.app.runonflux.io/v1/graphql",
        "SVG_HASURA_URL=https://aavegotchisvgbase_8080.app.runonflux.io/v1/graphql",
        "PORTAL_HASURA_URL=https://aavegotchiportalbase_8080.app.runonflux.io/v1/graphql",
        "ALCHEMICA_HASURA_URL=https://aavegotchialchemicabase_8080.app.runonflux.io/v1/graphql",
        "STAKING_HASURA_URL=https://aavegotchigltrstakingbase_8080.app.runonflux.io/v1/graphql",
        "GBM_HASURA_URL=https://aavegotchigbmbase_8080.app.runonflux.io/v1/graphql",
        "HASURA_ADMIN_SECRET=REPLACE_HASURA_SECRET"
      ],
      "commands": [],
      "containerData": "/tmp",
      "cpu": 1,
      "ram": 1024,
      "hdd": 2,
      "tiered": false
    }
  ]
}
